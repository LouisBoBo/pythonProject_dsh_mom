# 桌面一体包发版上传凭据（本文件勿提交；已在 .gitignore / svn:ignore *.env）
# 复制本文件为 desktop-upload.env 后填写。
#
# 也可不建本文件，直接在 engine/config/config.yaml 的 code_deploy 填：
#   ssh_host / ssh_user / ssh_port / ssh_key_path
# 上传脚本会自动回退读取（远端目录仍固定为 workbuddy-desktop，不用 ssh_app_path）。
#
# 打包成功后 package_desktop.py 会强制 scp 到远端，并只保留最近 2 个版本安装包。
# 破窗（仅本机调试）：WORKBUDDY_DESKTOP_SKIP_UPLOAD=1 或 --skip-upload

WORKBUDDY_DESKTOP_SSH_HOST=175.178.238.31
WORKBUDDY_DESKTOP_SSH_USER=root
WORKBUDDY_DESKTOP_SSH_PORT=22
# 本机私钥绝对路径，例如 C:\Users\你\.ssh\id_ed25519 或 ~/.ssh/id_ed25519
WORKBUDDY_DESKTOP_SSH_KEY=
WORKBUDDY_DESKTOP_REMOTE_DIR=/www/wwwroot/workbuddy-desktop
WORKBUDDY_DESKTOP_KEEP_VERSIONS=2
