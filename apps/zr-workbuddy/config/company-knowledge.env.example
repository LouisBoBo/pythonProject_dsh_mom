# 公司共享知识库：装包 / 接线 / 桌面启动时自动合并进 engine/config/config.yaml
# 复制为同目录 company-knowledge.env（该文件 gitignore，勿提交）。
# 员工机零手改：有本文件即可读公司库；管理员上传仍看账号 role===admin。
# 桌面打包：无本文件或 READ_TOKEN 为空时告警放行（不预置公司库）；有合格种子才打进包。
#
# 环境变量已设置同名项时，不覆盖（便于本机临时改指调试机）。
# 破窗（不合并）：WORKBUDDY_SKIP_COMPANY_KNOWLEDGE=1

# 中央知识 API 根（无尾斜杠）
# 产品默认 verify_ssl=true；现网自签证书须在种子显式写 false（勿把 false 写进发版默认以外的路径）
COMPANY_KNOWLEDGE_BASE_URL=https://175.178.238.31:8093
COMPANY_KNOWLEDGE_API_PREFIX=/knowledge-api/v1
COMPANY_KNOWLEDGE_KB_ID=default
COMPANY_KNOWLEDGE_TIMEOUT_MS=10000
COMPANY_KNOWLEDGE_VERIFY_SSL=false

# 只读 token（全员机必填，≥24）；写 token（建议同种子下发，引擎仍按管理员角色门禁）
COMPANY_KNOWLEDGE_READ_TOKEN=
COMPANY_KNOWLEDGE_WRITE_TOKEN=
